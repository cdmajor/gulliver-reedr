# Optional overrides for local website
PORT=5173
BASE_PATH=/

# Bake into the sideload zip when packing:
# REEDR_API_URL=https://gulliversoftwaretech.com/api
# npm run pack:extension

# Chrome Web Store package (bakes production API by default):
# npm run pack:cws

# Test the extension on your computer (no store needed):
#   npm run prepare:unpacked
#   Then chrome://extensions → Developer mode → Load unpacked → reedr-unpacked/
# Step-by-step: npm run dev → http://localhost:5173/how-to-test.html

# --- One-click install (after the store listing is Published) ---
# Example: https://chrome.google.com/webstore/detail/reedr/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_CHROME_WEB_STORE_URL=
VITE_EDGE_ADDONS_URL=
VITE_FIREFOX_ADDONS_URL=
