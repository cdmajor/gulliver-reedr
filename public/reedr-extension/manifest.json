{
  "manifest_version": 3,
  "name": "Reedr — AI Web Companion",
  "version": "1.1.2",
  "description": "Reedr reads every page you visit, chats about it, and saves organized threads and summaries — with Free and Plus memory tiers.",
  "homepage_url": "https://gulliversoftwaretech.com",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Reedr",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["memory.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icon16.png", "icon48.png", "icon128.png", "memory.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
